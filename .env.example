# Analytics Configuration
# Copy this file to .env.local and fill in your actual values

# Google Analytics 4
# Get your Measurement ID from Google Analytics 4 dashboard
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Umami Analytics
# Get your Website ID from your Umami dashboard
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Your Umami script source (default: https://analytics.umami.is/script.js)
NEXT_PUBLIC_UMAMI_SRC=https://analytics.umami.is/script.js

# Analytics Feature Flags
# Set to 'true' to enable each analytics service
NEXT_PUBLIC_ENABLE_GA=false
NEXT_PUBLIC_ENABLE_UMAMI=false
# Splitbee is enabled by default for backward compatibility
NEXT_PUBLIC_ENABLE_SPLITBEE=true

# Development vs Production
# In development, you might want to disable analytics
# NODE_ENV=development
